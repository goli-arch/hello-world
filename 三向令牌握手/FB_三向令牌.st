// ==================================================================
// FB_三向令牌 — 工位间三向握手令牌
// 版本 : V1.0
// 日期 : 2026-06-06
// 适用 : 信捷 XD/XE 系列
//
// 一条链路用两个实例，上下游各一个，REQ ↔ 对端确认 交叉接线
//
//  上游FB.请求信号 ────────→ 下游FB.对端确认
//  上游FB.对端确认 ←──────── 下游FB.请求信号
// ==================================================================

FUNCTION_BLOCK FB_三向令牌

VAR_INPUT
    // ====================== 控制输入 ======================
    角色            : BOOL;     // TRUE=上游(主动发起)，FALSE=下游(被动响应)
    本端就绪        : BOOL;     // 上游:有料待送；下游:空闲可接
    对端确认        : BOOL;     // 对方的请求信号（交叉接线）
    超时时间        : DINT;     // ms，等待对方响应的最长时限
    急停复位        : BOOL;     // TRUE 时强制清空所有状态

    // ====================== 诊断 ======================
    状态寄存器      : DINT;     // 上游写 D100 起，下游写 D200 起（外部传地址）
END_VAR

VAR_OUTPUT
    // ====================== 握手信号 ======================
    请求信号        : BOOL;     // 本端发出的 REQ/ACK（接对方"对端确认"）
    握手完成        : BOOL;     // 单周期脉冲，一次完整握手成功
    握手失败        : BOOL;     // 单周期脉冲，超时或异常
    当前步          : INT;      // 0=空闲 1=等待应答 2=等待释放

    // ====================== 报警输出 ======================
    超时报警        : BOOL;     // 等待对端确认超时
    握手故障        : BOOL;     // 握手过程中急停/异常中断
END_VAR

VAR
    _步             : INT;      // 0=空闲, 1=等待对端确认, 2=等待对端释放
    _超时标志       : BOOL;
    _握手完成记忆   : BOOL;     // 防止握手完成脉冲重复
END_VAR


// ==================================================================
// 状态机
// ==================================================================

// ---------- 急停：全部复位 ----------
IF 急停复位 THEN
    _步         := 0;
    请求信号    := FALSE;
    握手完成    := FALSE;
    握手失败    := FALSE;
    当前步      := 0;
    超时报警    := FALSE;
    握手故障    := FALSE;
    _超时标志   := FALSE;
    RETURN;
END_IF;

// ---------- 超时计时 ----------
IF _步 = 1 THEN
    TMR _超时标志, 超时时间, K100;
ELSE
    _超时标志 := FALSE;
END_IF;

// ---------- 状态输出 ----------
当前步 := _步;

// ==================================================================
// 上游模式 — 主动发起握手
// ==================================================================
IF 角色 THEN

    CASE _步 OF

        // ----- 步0：空闲，等待本端就绪 -----
        0:
            握手完成 := FALSE;
            握手失败 := FALSE;
            IF 本端就绪 THEN
                请求信号 := TRUE;       // 步1：发出请求 REQ
                _步      := 1;
            END_IF;

        // ----- 步1：REQ 已发出，等待对端回复 ACK -----
        1:
            IF 对端确认 THEN
                // 收到ACK → 走步3
                请求信号 := FALSE;      // 步3：清除 REQ
                超时报警 := FALSE;
                _步      := 2;
            ELSIF _超时标志 THEN
                // 超时 → 放弃
                请求信号 := FALSE;
                超时报警 := TRUE;
                握手失败 := TRUE;
                _步      := 0;
            END_IF;

        // ----- 步2：等待对端释放 ACK（握手闭环最后一步） -----
        2:
            IF NOT 对端确认 THEN
                // ACK释放 → 握手完成
                握手完成 := TRUE;
                _步      := 0;
            ELSIF _超时标志 THEN
                // 对端迟迟不释放 ACK
                超时报警 := TRUE;
                握手失败 := TRUE;
                _步      := 0;
            END_IF;

    END_CASE;

// ==================================================================
// 下游模式 — 被动响应握手
// ==================================================================
ELSE

    CASE _步 OF

        // ----- 步0：空闲，等待上游 REQ -----
        0:
            握手完成 := FALSE;
            握手失败 := FALSE;
            IF 对端确认 AND 本端就绪 THEN
                // 看到REQ ∧ 我空闲 → 回复ACK
                请求信号 := TRUE;       // 步2：回复 ACK
                _步      := 1;
            END_IF;

        // ----- 步1：ACK 已发出，等待上游释放 REQ -----
        1:
            IF NOT 对端确认 THEN
                // 上游清除REQ → 我也清除ACK
                请求信号 := FALSE;      // 步4：清除 ACK
                超时报警 := FALSE;
                _步      := 2;
            ELSIF _超时标志 THEN
                // 上游迟迟不释放REQ
                请求信号 := FALSE;
                超时报警 := TRUE;
                握手失败 := TRUE;
                _步      := 0;
            END_IF;

        // ----- 步2：等待确认对方收到释放（可选，安全冗余） -----
        2:
            握手完成 := TRUE;
            _步      := 0;

    END_CASE;

END_IF;

// ==================================================================
// 诊断写寄存器（可选，方便HMI监控）
// ==================================================================
IF 状态寄存器 > 0 THEN
    // D+0: 当前步
    // D+1: 0=空闲 1=等待 2=释放
    // D+2: 超时报警
END_IF;
