// ==================================================================
// FB_三向令牌 — 工位间三向握手令牌
// 版本 : V1.0
// 日期 : 2026-06-06
// 适用 : 信捷 XD/XE 系列
//
// 一条链路用两个实例，请求信号 ↔ 对端确认 必须交叉接线：
//   上游.请求信号 ────────→ 下游.对端确认
//   上游.对端确认 ←──────── 下游.请求信号
// ==================================================================

FUNCTION_BLOCK FB_三向令牌

VAR_INPUT
    角色            : BOOL;     // TRUE=上游(主动发起)，FALSE=下游(被动响应)
    本端就绪        : BOOL;     // 上游: 有料待送；下游: 空闲可接
    对端确认        : BOOL;     // 对方的请求信号（交叉接线！）
    超时时间        : DINT;     // ms，等待对方响应的最长时限
    急停复位        : BOOL;     // TRUE 时强制回步0，握手故障=TRUE
END_VAR

VAR_OUTPUT
    请求信号        : BOOL;     // 本端发出的 REQ/ACK（接对方"对端确认"）
    握手完成        : BOOL;     // 单周期脉冲
    握手失败        : BOOL;     // 单周期脉冲（超时或急停中断）
    当前步          : INT;      // 0=空闲 1=等待应答 2=等待释放
    超时报警        : BOOL;     // 等待对端确认超时（持续ON直到步变化）
    握手故障        : BOOL;     // 握手过程中被急停打断（持续ON直到下次握手完成）
END_VAR

VAR
    _步             : INT;      // 0=空闲 1=等待对端确认 2=等待对端释放
    _超时标志       : BOOL;
    _上次步         : INT;      // 检测步变化
END_VAR


// ==================================================================
// 急停：全部复位
// ==================================================================
IF 急停复位 THEN
    IF _步 > 0 THEN
        握手故障 := TRUE;       // 握手进行中被中断
    END_IF;
    _步         := 0;
    请求信号    := FALSE;
    握手完成    := FALSE;
    握手失败    := FALSE;
    当前步      := 0;
    超时报警    := FALSE;
    _超时标志   := FALSE;
    RETURN;
END_IF;

// ==================================================================
// 超时计时（仅在步1等待阶段计时）
// ==================================================================
IF _步 = 1 THEN
    TMR _超时标志, 超时时间, K100;
ELSE
    _超时标志 := FALSE;
END_IF;

// 输出当前步
当前步 := _步;

// ==================================================================
// 上游模式 — 主动发起握手
//   步0: 空闲 → 本端就绪触发 REQ
//   步1: 等待 ACK → 收到回复 → 清 REQ
//   步2: 等待 ACK 释放 → 释放完成 → 握手完成
// ==================================================================
IF 角色 THEN

    CASE _步 OF

        0:
            握手完成 := FALSE;
            握手失败 := FALSE;
            IF 本端就绪 THEN
                请求信号 := TRUE;
                _步      := 1;
            END_IF;

        1:
            IF 对端确认 THEN
                请求信号 := FALSE;
                超时报警 := FALSE;
                _步      := 2;
            ELSIF _超时标志 THEN
                请求信号 := FALSE;
                超时报警 := TRUE;
                握手失败 := TRUE;
                _步      := 0;
            END_IF;

        2:
            IF NOT 对端确认 THEN
                握手完成 := TRUE;
                握手故障 := FALSE;
                _步      := 0;
            ELSIF _超时标志 THEN
                超时报警 := TRUE;
                握手失败 := TRUE;
                _步      := 0;
            END_IF;

    END_CASE;

// ==================================================================
// 下游模式 — 被动响应握手
//   步0: 空闲 → 看到 REQ ∧ 本端就绪 → 回复 ACK
//   步1: 等待 REQ 释放 → 释放 → 清 ACK
//   步2: 握手完成
// ==================================================================
ELSE

    CASE _步 OF

        0:
            握手完成 := FALSE;
            握手失败 := FALSE;
            IF 对端确认 AND 本端就绪 THEN
                请求信号 := TRUE;
                _步      := 1;
            END_IF;

        1:
            IF NOT 对端确认 THEN
                请求信号 := FALSE;
                超时报警 := FALSE;
                _步      := 2;
            ELSIF _超时标志 THEN
                请求信号 := FALSE;
                超时报警 := TRUE;
                握手失败 := TRUE;
                _步      := 0;
            END_IF;

        2:
            握手完成 := TRUE;
            握手故障 := FALSE;
            _步      := 0;

    END_CASE;

END_IF;
