// ==================================================================
// 三向令牌 — 接线示例（以"左前等待 → 前平移机"为例）
// ==================================================================

VAR_GLOBAL
    // 两个 FB 实例
    左前_上游令牌  : FB_三向令牌;
    前平移_下游令牌 : FB_三向令牌;

    // 物理信号
    M30  : BOOL;    // 左前传感器：有板=ON
    M41  : BOOL;    // 前平移机在位：空闲=ON
    M1090: BOOL;    // 前门开到位
    M221 : BOOL;    // 急停

    // 握手超时时间 ms
    HD200: DINT := 3000;  // 3秒超时
END_VAR

// ==================================================================
// 上游（左前等待线体）
// 思路："我有板 AND 下游不在中间位" → 发起握手
// ==================================================================
左前_上游令牌(
    角色        := TRUE,                       // 主动方
    本端就绪    := M30 AND (NOT M41),          // 有板 ∧ 下游没占着中间位
    对端确认    := 前平移_下游令牌.请求信号,   // 交叉接下游的ACK
    超时时间    := HD200,
    急停复位    := M221
);

// ==================================================================
// 下游（前平移机）
// 思路："看到上游REQ AND 我空闲" → 回复握手
// ==================================================================
前平移_下游令牌(
    角色        := FALSE,                      // 被动方
    本端就绪    := M1090,                      // 前门到位 = 我空闲可接板
    对端确认    := 左前_上游令牌.请求信号,     // 交叉接上游的REQ
    超时时间    := HD200,
    急停复位    := M221
);

// ==================================================================
// 上游处理握手结果
// ==================================================================
IF 左前_上游令牌.握手完成 THEN
    // 下游已确认，开始送板
    // D1006 状态推进等...
END_IF;

IF 左前_上游令牌.超时报警 THEN
    // 下游没回应，停板报警
    SET M_报警_送板超时;
END_IF;

// ==================================================================
// 下游处理握手结果
// ==================================================================
IF 前平移_下游令牌.握手完成 THEN
    // 握手闭环，开始接板动作
    // D1001 状态推进...
END_IF;

