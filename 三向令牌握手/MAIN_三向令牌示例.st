// ==================================================================
// 三向令牌 — 调用示例
//
// 以"工位A(上游) → 工位B(下游)"一条链路为例
//
// 关键规则：请求信号 ↔ 对端确认 必须交叉接线
// ==================================================================

VAR_GLOBAL
    // ====================== 两个实例 ======================
    工位A_令牌 : FB_三向令牌;   // 上游
    工位B_令牌 : FB_三向令牌;   // 下游

    // ====================== 物理信号 ======================
    A_有料检测       : BOOL;    // 传感器：上游有料=ON
    B_空闲检测       : BOOL;    // 传感器：下游空闲=ON
    系统急停         : BOOL;    // 常闭触点

    // ====================== 参数 ======================
    握手超时ms       : DINT := 3000;   // 3秒
END_VAR

// ==================================================================
// 上游 — 主动发起
// ==================================================================
工位A_令牌(
    角色     := TRUE,
    本端就绪 := A_有料检测 AND (NOT B_空闲检测),  // 有料 ∧ 下游没占着共享位
    对端确认 := 工位B_令牌.请求信号,              // ← 交叉接下游
    超时时间 := 握手超时ms,
    急停复位 := 系统急停
);

// ==================================================================
// 下游 — 被动响应
// ==================================================================
工位B_令牌(
    角色     := FALSE,
    本端就绪 := B_空闲检测,                       // 我空闲可接
    对端确认 := 工位A_令牌.请求信号,              // ← 交叉接上游
    超时时间 := 握手超时ms,
    急停复位 := 系统急停
);

// ==================================================================
// 处理握手结果
// ==================================================================

// 上游 — 握手成功 → 开始送料
IF 工位A_令牌.握手完成 THEN
    // 启动送料电机 / 推进状态机 ...
END_IF;

// 上游 — 握手失败 → 报警
IF 工位A_令牌.握手失败 OR 工位A_令牌.超时报警 THEN
    // SET 报警位 ...
END_IF;

// 下游 — 握手成功 → 开始接料
IF 工位B_令牌.握手完成 THEN
    // 启动接料气缸 / 推进状态机 ...
END_IF;

