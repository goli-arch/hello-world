// *********************************************************************
// 单轴双电机防碰撞 + 预等待控制系统 — 主程序
// 版本     : V1.1
// 日期     : 2026-06-06
// 适用 PLC : 信捷 XD5E-48T10-E
// *********************************************************************

VAR_GLOBAL
    // ====================== 系统 IO ======================
    自动模式开关        : BOOL  AT %IX0.0;
    系统急停按钮        : BOOL  AT %IX0.1;
    报警复位按钮        : BOOL  AT %IX0.2;

    // ====================== 手动模式 IO ======================
    手动A正向点动按钮   : BOOL  AT %IX0.3;
    手动A反向点动按钮   : BOOL  AT %IX0.4;
    手动B正向点动按钮   : BOOL  AT %IX0.5;
    手动B反向点动按钮   : BOOL  AT %IX0.6;

    // ====================== 工艺信号 IO ======================
    A夹爪夹紧完成       : BOOL  AT %IX1.0;
    A夹爪张开完成       : BOOL  AT %IX1.1;
    B夹爪夹紧完成       : BOOL  AT %IX1.2;
    B夹爪张开完成       : BOOL  AT %IX1.3;
    A取料位有料         : BOOL  AT %IX1.4;

    // ====================== 伺服反馈 IO ======================
    轴1_当前位置        : DINT  AT %ID0;
    轴1_BUSY            : BOOL  AT %IX2.0;
    轴1_INP             : BOOL  AT %IX2.1;
    轴1_故障            : BOOL  AT %IX2.2;
    轴2_当前位置        : DINT  AT %ID4;
    轴2_BUSY            : BOOL  AT %IX2.3;
    轴2_INP             : BOOL  AT %IX2.4;
    轴2_故障            : BOOL  AT %IX2.5;

    // ====================== 报警输出 IO ======================
    系统故障灯          : BOOL  AT %QX0.0;
    急停报警灯          : BOOL  AT %QX0.1;
    防撞报警灯          : BOOL  AT %QX0.2;
    伺服故障灯          : BOOL  AT %QX0.3;

    // ====================== 实例化功能块 ======================
    拆治具机双电机      : FB_SingleAxisDualMotor;
END_VAR

// *********************************************************************
// 主程序调用
// *********************************************************************
拆治具机双电机(
    // 系统模式控制
    自动模式          := 自动模式开关,
    系统急停          := 系统急停按钮,
    报警复位          := 报警复位按钮,

    // 手动模式控制
    手动A正向点动     := 手动A正向点动按钮,
    手动A反向点动     := 手动A反向点动按钮,
    手动B正向点动     := 手动B正向点动按钮,
    手动B反向点动     := 手动B反向点动按钮,
    手动点动速度      := 500,

    // 轴号配置
    电机A轴号         := 1,
    电机B轴号         := 2,

    // 区域参数
    A专属区右边界     := 470,
    A等待区右边界     := 490,
    共享区右边界      := 510,
    B等待区右边界     := 530,

    // 目标位置
    A取料位           := 0,
    A放料位           := 500,
    B取料位           := 500,
    B放料位           := 1000,
    A等待位           := 470,
    B等待位           := 530,

    // 运动参数
    自动运动速度      := 1500,
    加速度            := 1000,
    减速度            := 1000,

    // 安全参数
    最小安全距离      := 30,
    送料优先级高于取料 := TRUE,

    // 工艺信号
    A取料完成         := A夹爪夹紧完成,
    A放料完成         := A夹爪张开完成,
    B取料完成         := B夹爪夹紧完成,
    B放料完成         := B夹爪张开完成,
    有料待送          := A取料位有料,

    // 伺服反馈
    电机A_当前位置    := 轴1_当前位置,
    电机A_运行中      := 轴1_BUSY,
    电机A_到位        := 轴1_INP,
    电机A_故障        := 轴1_故障,
    电机B_当前位置    := 轴2_当前位置,
    电机B_运行中      := 轴2_BUSY,
    电机B_到位        := 轴2_INP,
    电机B_故障        := 轴2_故障
);

// 报警灯输出
系统故障灯 := 拆治具机双电机.报警_系统故障;
急停报警灯 := 拆治具机双电机.报警_急停触发;
防撞报警灯 := 拆治具机双电机.报警_防撞触发;
伺服故障灯 := 拆治具机双电机.报警_A伺服故障 OR 拆治具机双电机.报警_B伺服故障;
